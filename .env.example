# Copy to backend/.env (PM2) or pass as container env (Docker).
# NOTE: there are NO provider API keys here — users bring their own, per request, never stored.

DATABASE_URL=postgresql+asyncpg://sandroid:sandroid@localhost:5432/sandroid

# Comma-separated, only if the UI is served from a different origin than the API.
CORS_ORIGINS=

# Behind Nginx/Cloudflare: true, so rate limits see the real client IP.
TRUST_PROXY_HEADERS=false

# Rate limits per IP per minute (in-memory, single instance)
RATE_LIMIT_READ_PER_MIN=120
RATE_LIMIT_RUN_PER_MIN=30
RATE_LIMIT_ARENA_PER_MIN=10
RATE_LIMIT_RESEARCH_PER_MIN=5
ARENA_MAX_ACTIVE_PER_IP=2
ARENA_MAX_PARALLEL_PER_IP=1

RESEARCH_COOLDOWN_SECONDS=3600
MAX_BODY_BYTES=10485760
LOG_LEVEL=INFO

# SELF-HOSTED / LOCAL ONLY — allows private-network and plain-http endpoints (e.g. Ollama).
# Never enable on a public deployment: it re-opens SSRF to your internal network.
SSRF_ALLOW_PRIVATE=false
SSRF_ALLOW_HTTP=false
